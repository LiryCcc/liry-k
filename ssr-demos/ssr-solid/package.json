{
  "name": "ssr-solid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "dev": "node server",
    "preview": "cross-env NODE_ENV=production node server"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "normalize.css": "catalog:",
    "sirv": "^3.0.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "vite": "^8.0.3",
    "vite-plugin-solid": "^2.11.11"
  }
}
