    "lint:code": "eslint . --cache",
    "lint:type": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@yume-chan/async": "^4.1.3",
    "@yume-chan/struct": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@liry-k/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
