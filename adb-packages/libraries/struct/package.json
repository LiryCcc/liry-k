{
  "name": "@yume-chan/struct",
  "version": "2.0.1",
  "description": "C-style structure serializer and deserializer.",
  "keywords": [
    "structure",
    "serialization",
    "deserialization",
    "typescript"
  ],
  "homepage": "https://github.com/yume-chan/ya-webadb/tree/main/libraries/struct#readme",
  "bugs": {
    "url": "https://github.com/yume-chan/ya-webadb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yume-chan/ya-webadb.git",
    "directory": "libraries/struct"
  },
  "license": "MIT",
  "author": {
    "name": "Simon Chan",
    "email": "cnsimonchan@live.com",
    "url": "https://chensi.moe/blog"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "liry-build",
    "lint": "pnpm lint:type && pnpm lint:code",
    "lint:code": "eslint . --cache",
    "lint:type": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@yume-chan/async": "^4.1.3",
    "@yume-chan/no-data-view": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@liry-k/build": "workspace:*",
    "@liry-k/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
