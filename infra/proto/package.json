{
  "name": "@liry-k/proto",
  "version": "1.0.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm proto && liry-build",
    "format": "buf format -w ./protos",
    "postinstall": "pnpm proto",
    "lint": "tsc -b",
    "proto": "node run-protoc.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@liry-k/build": "workspace:*",
    "@types/node": "catalog:",
    "protoc": "^35.1.0",
    "ts-proto": "^2.11.10",
    "typescript": "catalog:"
  }
}
