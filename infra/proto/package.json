{
  "name": "@liry-k/proto",
  "version": "1.0.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm proto && liry-build",
    "format": "buf format -w ./protos",
    "postinstall": "pnpm proto",
    "lint": "tsc -b",
    "proto": "pnpm postproto && pnpm protoc --proto_path=./protos --plugin=protoc-gen-ts_proto=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=esModuleInterop=true,outputClientImpl=false,outputServices=none,useExactTypes=false,nestJs=false,importSuffix=.js,useExplicitNext=true ./protos/*.proto",
    "postproto": "node post-proto.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.69.0",
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@liry-k/build": "workspace:*",
    "@types/node": "^24.12.3",
    "protoc": "^25.9.0",
    "ts-proto": "^2.11.8",
    "typescript": "^6.0.3"
  }
}
