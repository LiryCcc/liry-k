{
  "name": "@liry-k/ssr-server",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["tsdown", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    },
    "tsdown": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["tsdown", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsdown",
        "cwd": "{projectRoot}"
      }
    }
  }
}
