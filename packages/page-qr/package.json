{
  "name": "@liry-k/page-qr",
  "version": "0.0.0",
  "private": true,
  "description": "Generate a QR code for the current page URL",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "lint": "tsc -b",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "normalize.css": "catalog:",
    "solid-js": "catalog:",
    "uqr": "^0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@liry-k/tsconfig": "workspace:*",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "catalog:",
    "wxt": "^0.20.27"
  }
}
