# Common Bazel settings for the liry-k monorepo.
common --enable_bzlmod

build --spawn_strategy=local
test --spawn_strategy=local
# Local action cache (repeat builds skip unchanged packages).
build --disk_cache=~/.cache/bazel-disk
test --spawn_strategy=local
test --test_output=errors
test --test_summary=short
test --test_env=HOME
test --test_env=USER
test --test_env=PATH
