{
  "name": "sirius",
  "projectType": "application",
  "sourceRoot": "rust-packages/sirius/src",
  "tags": ["lang:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo build -p sirius",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo clippy -p sirius --all-targets -- -D warnings",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint:rust": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo clippy -p sirius --all-targets -- -D warnings",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint:rustfmt": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo fmt -p sirius -- --check",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo test -p sirius",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
