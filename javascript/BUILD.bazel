# Aggregate JavaScript build/test targets (generated by tools/bazel/generate-js-builds.mjs).

package(default_visibility = ["//visibility:public"])

_BUILD_TARGETS = [
    "//apps/adb-web:build",
    "//apps/adb-web-new:build",
    "//apps/gomoku:build",
    "//apps/liry-cv:build",
    "//apps/liry-site-server:build",
    "//apps/luna:build",
    "//apps/multi-downloader:build",
    "//apps/page-qr:build",
    "//apps/polaris:build",
    "//demos/r3f-d:build",
    "//demos/ssr-preact:build",
    "//demos/ssr-react:build",
    "//demos/ssr-solid:build",
    "//infra/ast-grep:build",
    "//infra/core:build",
    "//infra/eslint-config:build",
    "//infra/lc:build",
    "//infra/log-sdk:build",
    "//infra/proto:build",
    "//packages/astra:build",
    "//packages/rigel:build",
    "//packages/ssr-server:build",
    "//packages/stellar:build",
]

genrule(
    name = "build",
    srcs = _BUILD_TARGETS,
    outs = ["build.stamp"],
    cmd = "touch \"$@\"",
)

genrule(
    name = "test",
    srcs = ["//packages/leetcode:test"],
    outs = ["test.stamp"],
    cmd = "touch \"$@\"",
)
