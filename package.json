{
  "name": "@liry-k/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build --exclude=tag:lang:rust,tag:lang:java",
    "check-format": "prettier --check --cache .",
    "check-spell": "cspell .",
    "format": "prettier --write --cache . && pnpm -r format",
    "postinstall": "pnpm build",
    "lint": "pnpm pre-commit",
    "lint:rust": "nx run-many -t lint:rust",
    "lint:rustfmt": "nx run-many -t lint:rustfmt",
    "lint:style": "stylelint \"*/**/*.css\"",
    "pre-commit": "nx run @liry-k/monorepo:check-format && nx run @liry-k/monorepo:check-spell && nx run @liry-k/monorepo:lint:style && nx run-many -t lint,lint:rustfmt",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm pre-commit",
    "commit-msg": "pnpm commitlint --edit"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@liry-k/tsconfig": "workspace:*",
    "@nx/eslint": "23.1.1",
    "@nx/gradle": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@types/node": "catalog:",
    "cspell": "^10.0.1",
    "eslint": "catalog:",
    "nx": "23.1.1",
    "pkg-types": "^2.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-toml": "^2.0.6",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "catalog:",
    "vite-tsconfig-paths": "5.1.4"
  },
  "nx": {
    "includedScripts": [
      "check-format",
      "check-spell",
      "format",
      "lint:style"
    ]
  }
}
