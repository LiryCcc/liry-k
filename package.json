{
  "name": "@liry-k/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check-format": "prettier --check --cache .",
    "check-spell": "cspell .",
    "format": "prettier --write --cache . && pnpm -r format",
    "postinstall": "pnpm build",
    "lint": "pnpm pre-commit",
    "pre-commit": "pnpm check-format && pnpm check-spell && pnpm -r lint",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm pre-commit",
    "commit-msg": "pnpm commitlint --edit"
  },
  "dependencies": {
    "cspell": "^10.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@liry-k/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pkg-types": "^2.3.1",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-toml": "^2.0.6",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "catalog:"
  }
}
