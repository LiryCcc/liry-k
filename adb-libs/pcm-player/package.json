  },
  "dependencies": {
    "@types/w3c-web-usb": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@liry-k/build": "workspace:*",
    "@liry-k/tsconfig": "workspace:*",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
