{
  "name": "@liry-k/pcm-player",
  "version": "1.0.0",
  "description": "Play raw audio sample stream using Web Audio API",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "liry-build",
