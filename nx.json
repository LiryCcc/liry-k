{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/src/test/**/*"],
    "sharedGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/settings.gradle.kts",
      "{workspaceRoot}/build.gradle.kts"
    ],
    "tsdown": ["{projectRoot}/tsdown.config.ts", "{projectRoot}/src/**/*", "production"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.output"]
    },
    "vite:build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.output"]
    },
    "tsdown": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["tsdown", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "lint:code": {
      "cache": true
    },
    "lint:type": {
      "cache": true
    },
    "lint:rust": {
      "cache": true
    },
    "lint:rustfmt": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint:code"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "vite:build",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveTargetName": "serve"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/gradle",
      "options": {
        "testTargetName": "test",
        "classesTargetName": "classes",
        "buildTargetName": "build"
      }
    }
  ],
  "analytics": false
}
